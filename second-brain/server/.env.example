# Puoi mettere questo file anche in ~/SecondBrain/.env (vale per app desktop, server e MCP)
# Porta del server API
PORT=3001
# Percorso del database SQLite (default: ~/SecondBrain/second-brain.db)
# DB_PATH=./data/second-brain.db
# Password opzionale: se impostata, l'app chiede di accedere
# APP_PASSWORD=cambiami
# Chiave API Anthropic per l'assistente AI (opzionale)
# ANTHROPIC_API_KEY=sk-ant-...
# Modello AI (default: claude-opus-5-5)
# AI_MODEL=claude-opus-5-5
# Indirizzo di ascolto: 127.0.0.1 = solo questo computer, 0.0.0.0 = anche dalla rete locale (imposta APP_PASSWORD!)
# HOST=127.0.0.1
